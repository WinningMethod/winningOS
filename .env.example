# WinningOS Core environment example
# Copy this file to .env.local for local development.
# Do not commit .env.local or real secret values.
#
# Deployment isolation rule:
# every clone/deployment of WinningOS needs its own fresh Supabase project.
# Never copy .env.local from winningOS, another company deployment, or a scratch
# test repo. Reusing a project means migrations, users, roles, plugin tables,
# and audit data all share one database.

# Browser-safe app origin used as a fallback for auth redirect URLs.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Browser-safe Supabase variables for Next.js / @supabase/ssr helpers.
# These are intentionally public because access is protected by Supabase RLS policies.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-or-publishable-key"

# Server-only Supabase variable for legacy/admin helper paths.
# Never expose this through NEXT_PUBLIC_* and never import it into client components.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Direct @supabase/server request-handler variables.
# Copy the real values from the Supabase dashboard Connect dialog.
# Never commit SUPABASE_SECRET_KEY.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
SUPABASE_SECRET_KEY="your-supabase-secret-key"

# Migration/config operations for this deployment's own Supabase project.
# SUPABASE_DB_PASSWORD is the database password set when the project is created.
# SUPABASE_DB_URL should use the same project ref as NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_PROJECT_REF="your-project-ref"
SUPABASE_DB_PASSWORD="your-database-password"
SUPABASE_DB_URL="postgresql://postgres:your-percent-encoded-database-password@db.your-project-ref.supabase.co:5432/postgres"

# Optional: needed only when pushing hosted Auth config with `supabase config push`.
SUPABASE_ACCESS_TOKEN="your-supabase-personal-access-token"

# Optional JWKS URL for verifying user JWTs.
# WinningOS derives this from SUPABASE_URL when blank.
# If set, its origin must match SUPABASE_URL.
SUPABASE_JWKS_URL=""
